## Example Kamal secrets file (DO NOT COMMIT real secrets)
# Copy this to `.kamal/secrets` on your deploy machine and fill values securely.

# If you want Kamal to start a Postgres accessory container, set these:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=very_strong_password_here

# Rails master key for decrypting production credentials
# (the contents of config/credentials/production.key)
RAILS_MASTER_KEY=your_production_master_key_here

# Optionally you can set DATABASE_URL instead of individual DB credentials:
# DATABASE_URL=postgres://user:password@host:5432/red_tape_reporter_production

# Kamal registry auth token (for pushing/pulling images)
# KAMAL_REGISTRY_PASSWORD=your_registry_token_here
