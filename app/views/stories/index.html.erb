<% content_for :meta_title, "Public Stories | Red Tape LA" %>
<% content_for :meta_description, "Read real stories from LA residents facing bureaucratic delays. Filter by location, issue type, and timeline impact. Add your support to similar issues." %>

<div class="container">
  <header>
    <h1 class="hero-title">Public Stories</h1>
    <p class="hero-subtitle">
      Real experiences from <%= @total_stories %> Angelenos. All stories are anonymous.
      Find issues similar to yours and show your support.
    </p>
  </header>

  <% if @total_stories == 0 %>
    <section class="card">
      <p class="text-large">No public stories yet. When people opt in to share their approved stories publicly, they'll appear here.</p>
      <p class="text-large mt-md">
        <%= link_to "Share your own story", new_report_path, class: "btn btn-gold" %>
      </p>
    </section>
  <% else %>

    <!-- Aggregate Statistics -->
    <section class="dashboard-stats mb-lg">
      <div class="stat-card">
        <div class="stat-number"><%= @total_stories %></div>
        <div class="stat-label">Public Stories</div>
      </div>

      <div class="stat-card">
        <div class="stat-number"><%= @total_votes %></div>
        <div class="stat-label">Community Support Votes</div>
      </div>

      <div class="stat-card">
        <div class="stat-number"><%= @stories_with_financial_impact %></div>
        <div class="stat-label">With Financial Impact</div>
      </div>
    </section>

    <!-- NOTE: Filters moved lower on the page to de-emphasize them visually -->

    <!-- Top 3 Issues (detailed cards) -->
    <% if @top_issues.present? %>
      <section class="card mb-lg">
        <h2 class="section-title">Most Common Issues</h2>
        <div class="breakdown-list">
          <% @top_issues.each do |issue| %>
            <div class="breakdown-item">
              <div class="breakdown-header">
                <div class="breakdown-label"><%= issue[:category] %></div>
                <span class="tag"><%= issue[:category] %></span>
              </div>

              <div class="breakdown-meta">
                <div class="meta-item">
                  <span class="meta-label">Others Affected</span>
                  <div class="meta-value"><%= issue[:count] %></div>
                </div>

                <div class="meta-item">
                  <span class="meta-label">Cost Impact</span>
                  <div class="meta-value"><%= issue[:sample_cost] || "—" %></div>
                </div>

                <div class="meta-item">
                  <span class="meta-label">Scale</span>
                  <div class="meta-value"><%= issue[:scale] %> <%= issue[:scale] == 1 ? "project" : "projects" %></div>
                </div>
              </div>

              <% if issue[:stories].any? %>
                <hr class="breakdown-divider">
                <% issue[:stories].each do |s| %>
                  <p class="meta-small"><strong><%= truncate(s.location, length: 40) %>:</strong> <%= truncate(s.issue_description, length: 150) %></p>
                <% end %>
              <% end %>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>

    <!-- Stories List -->
    <section class="section">
      <h2 class="section-title mb-md">All Stories</h2>

      <div class="stories-grid">
        <% @stories.each do |story| %>
          <div class="card story-card">
            <div class="story-header">
              <span class="story-type"><%= story.project_type %></span>
              <span class="story-location"><%= story.location %></span>
            </div>

            <div class="story-impact-badges">
              <span class="badge badge-timeline"><%= story.timeline_impact %></span>
              <% if story.financial_impact.present? %>
                <span class="badge badge-financial"><%= story.financial_impact %></span>
              <% end %>
            </div>

            <div class="story-content">
              <p class="story-description">
                <%= truncate(story.issue_description, length: 200) %>
              </p>
            </div>

            <div class="story-meta">
              <div class="story-tags">
                <% story.departments.first(3).each do |dept| %>
                  <span class="tag"><%= dept %></span>
                <% end %>
              </div>

              <div class="story-actions">
                <span class="vote-count">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                    <path d="M2 10h2v5a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1v-5h2a1 1 0 0 0 .707-1.707l-6-6a1 1 0 0 0-1.414 0l-6 6A1 1 0 0 0 2 10z"/>
                  </svg>
                  <%= story.vote_count %> support
                </span>
                <span class="comment-count">
                  <%= story.comments.count %> <%= "comment".pluralize(story.comments.count) %>
                </span>
              </div>
            </div>

            <%= link_to "Read Full Story", story_path(story), class: "btn btn-secondary btn-block mt-md" %>
          </div>
        <% end %>
      </div>

      <% if @stories.empty? %>
        <div class="card">
          <p class="text-large">No stories available at this time.</p>
        </div>
      <% end %>
    </section>

  <% end %>

  <!-- Call to Action -->
  <section class="cta-section">
    <div class="card cta-card">
      <h2 class="section-title">Have a similar experience?</h2>
      <p class="text-large mb-md">
        Share your story and help build the case for bureaucratic reform in LA.
        You can choose to make it public so others can see they're not alone.
      </p>
      <%= link_to "Share Your Story", new_report_path, class: "btn btn-gold btn-large" %>
    </div>
  </section>
</div>

