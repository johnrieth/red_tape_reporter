<% content_for :meta_title, "Public Stories | Red Tape LA" %>
<% content_for :meta_description, "Read real stories from LA residents facing bureaucratic delays. Filter by location, issue type, and timeline impact. Add your support to similar issues." %>

<div class="container">
  <header>
    <h1 class="hero-title">Public Stories</h1>
    <p class="hero-subtitle">
      Real experiences from <%= @total_stories %> people who opted to share their stories publicly.
      All stories are anonymous. Find issues similar to yours and show your support.
    </p>
  </header>

  <% if @total_stories == 0 %>
    <section class="card">
      <p class="text-large">No public stories yet. When people opt-in to share their approved stories publicly, they'll appear here.</p>
      <p class="text-large mt-md">
        <%= link_to "Share your own story", new_report_path, class: "btn btn-gold" %>
      </p>
    </section>
  <% else %>

    <!-- Aggregate Statistics -->
    <section class="dashboard-stats mb-lg">
      <div class="stat-card">
        <div class="stat-number"><%= @total_stories %></div>
        <div class="stat-label">Public Stories</div>
      </div>

      <div class="stat-card">
        <div class="stat-number"><%= @total_votes %></div>
        <div class="stat-label">Community Support Votes</div>
      </div>

      <div class="stat-card">
        <div class="stat-number"><%= @stories_with_financial_impact %></div>
        <div class="stat-label">With Financial Impact</div>
      </div>
    </section>

    <!-- Filters -->
    <section class="card mb-lg">
      <h2 class="section-title">Filter Stories</h2>

      <%= form_with url: stories_path, method: :get, local: true, class: "filter-form" do |f| %>
        <div class="filter-grid">
          <div class="form-group">
            <%= f.label :location, "Location" %>
            <%= f.text_field :location, value: params[:location], placeholder: "e.g., Los Angeles, Downtown" %>
          </div>

          <div class="form-group">
            <%= f.label :category, "Issue Category" %>
            <%= f.select :category,
                options_for_select(Report::ISSUE_CATEGORIES, params[:category]),
                { prompt: "All categories" } %>
          </div>

          <div class="form-group">
            <%= f.label :department, "Department" %>
            <%= f.select :department,
                options_for_select(Report::DEPARTMENTS, params[:department]),
                { prompt: "All departments" } %>
          </div>

          <div class="form-group">
            <%= f.label :timeline, "Timeline Impact" %>
            <%= f.select :timeline,
                options_for_select(Report::TIMELINE_IMPACTS, params[:timeline]),
                { prompt: "All timelines" } %>
          </div>
        </div>

        <div class="form-actions">
          <%= f.submit "Apply Filters", class: "btn btn-primary" %>
          <%= link_to "Clear Filters", stories_path, class: "btn btn-secondary" %>
        </div>
      <% end %>
    </section>

    <!-- Top Issues Breakdown -->
    <% if @category_breakdown.any? %>
      <section class="card mb-lg">
        <h2 class="section-title">Most Common Issues</h2>
        <div class="breakdown-list">
          <% @category_breakdown.each do |category, count| %>
            <div class="breakdown-item">
              <span class="breakdown-label"><%= category %></span>
              <span class="breakdown-count"><%= count %> <%= "story".pluralize(count) %></span>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>

    <!-- Stories List -->
    <section class="section">
      <h2 class="section-title mb-md">
        <%= params.keys.any? { |k| k != "controller" && k != "action" && params[k].present? } ? "Filtered Stories" : "All Stories" %>
      </h2>

      <div class="stories-grid">
        <% @stories.each do |story| %>
          <div class="card story-card">
            <div class="story-header">
              <span class="story-type"><%= story.project_type %></span>
              <span class="story-location"><%= story.location %></span>
            </div>

            <div class="story-impact-badges">
              <span class="badge badge-timeline"><%= story.timeline_impact %></span>
              <% if story.financial_impact.present? %>
                <span class="badge badge-financial"><%= story.financial_impact %></span>
              <% end %>
            </div>

            <div class="story-content">
              <p class="story-description">
                <%= truncate(story.issue_description, length: 200) %>
              </p>
            </div>

            <div class="story-meta">
              <div class="story-tags">
                <% story.departments.first(3).each do |dept| %>
                  <span class="tag"><%= dept %></span>
                <% end %>
              </div>

              <div class="story-actions">
                <span class="vote-count">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                    <path d="M2 10h2v5a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1v-5h2a1 1 0 0 0 .707-1.707l-6-6a1 1 0 0 0-1.414 0l-6 6A1 1 0 0 0 2 10z"/>
                  </svg>
                  <%= story.vote_count %> support
                </span>
                <span class="comment-count">
                  <%= story.comments.count %> <%= "comment".pluralize(story.comments.count) %>
                </span>
              </div>
            </div>

            <%= link_to "Read Full Story", story_path(story), class: "btn btn-secondary btn-block mt-md" %>
          </div>
        <% end %>
      </div>

      <% if @stories.empty? %>
        <div class="card">
          <p class="text-large">No stories match your filters. Try adjusting your criteria.</p>
        </div>
      <% end %>
    </section>

  <% end %>

  <!-- Call to Action -->
  <section class="cta-section">
    <div class="card cta-card">
      <h2 class="section-title">Have a similar experience?</h2>
      <p class="text-large mb-md">
        Share your story and help build the case for bureaucratic reform in LA.
        You can choose to make it public so others can see they're not alone.
      </p>
      <%= link_to "Share Your Story", new_report_path, class: "btn btn-gold btn-large" %>
    </div>
  </section>
</div>

<style>
/* Stripe / 37Signals inspired minimal styles while preserving site's color variables */

:root {
  --max-width: 1100px;
  --gutter: 24px;
  --card-radius: 10px;
  --card-bg: #fff;
  --muted: var(--text-muted, #6b7280);
  --accent: var(--text-primary, #1f2937);
}

.container {
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 48px var(--gutter);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  color: var(--accent);
}

header .hero-title {
  font-size: 34px;
  line-height: 1.15;
  margin: 0 0 8px 0;
  font-weight: 700;
}

header .hero-subtitle {
  color: var(--muted);
  margin: 0 0 22px 0;
  font-size: 16px;
}

/* Metrics */
.dashboard-stats {
  display: flex;
  gap: 16px;
  background: linear-gradient(180deg,#ffffff,#fbfdff);
  border-radius: var(--card-radius);
  padding: 22px;
  box-shadow: 0 1px 0 rgba(16,24,40,0.03), 0 8px 24px rgba(16,24,40,0.06);
  margin-bottom: 28px;
  align-items: center;
  justify-content: space-between;
}

.stat-card {
  flex: 1 1 0;
  text-align: center;
  padding: 6px 10px;
}

.stat-number {
  font-size: 28px;
  font-weight: 700;
  color: var(--accent);
}

.stat-label {
  color: var(--muted);
  font-size: 13px;
  margin-top: 6px;
}

/* Filters card */
.card {
  background: var(--card-bg);
  border: 1px solid var(--border-light, #e9ecef);
  border-radius: var(--card-radius);
  padding: 18px;
  box-shadow: none;
}

.filter-form .form-group label {
  display: block;
  font-weight: 600;
  margin-bottom: 6px;
  color: var(--accent);
}

.filter-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 12px;
  margin-bottom: 12px;
}

.form-actions { display:flex; gap:12px; align-items:center }

.btn-gold { background: #f59e0b; color: #111; border-radius:8px; padding:10px 14px }
.btn-primary { background:#0b63ff; color:#fff; border-radius:8px; padding:10px 14px }

/* Most common issues */
.breakdown-list { display:flex; flex-direction:column; gap:14px }
.breakdown-item { padding:18px; border-radius:10px; border:1px solid var(--border-light, #e9ecef); box-shadow:0 6px 18px rgba(16,24,40,0.04); background:var(--card-bg) }
.breakdown-label { font-weight:700; font-size:16px }

/* Stories grid */
.stories-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 18px;
}

.story-card {
  display:flex; flex-direction:column; height:100%; padding:18px; border-radius:10px; background:var(--card-bg);
  border:1px solid var(--border-light, #e9ecef);
  box-shadow: 0 6px 20px rgba(16,24,40,0.04);
}

.story-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:10px }
.story-type { font-weight:700; color:var(--accent) }
.story-location { color:var(--muted); font-size:13px }

.story-impact-badges { margin-bottom:12px }
.badge { font-weight:600; font-size:12px; padding:6px 10px; border-radius:999px }

.story-description { color:var(--muted); line-height:1.5 }

.story-meta { display:flex; justify-content:space-between; align-items:center; margin-top:14px }
.story-actions { color:var(--muted); font-size:13px }

.tag { background:#f3f4f6; color:#334155; padding:6px 8px; border-radius:999px; font-size:12px }

.cta-section { margin-top:36px }
.cta-card { padding:28px; text-align:center }

@media (max-width: 760px) {
  .container { padding: 24px }
  header .hero-title { font-size:24px }
  .dashboard-stats { flex-direction:column; gap:12px; align-items:stretch }
}

</style>
